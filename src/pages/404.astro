---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Reel Missing"
  description="The requested reel or dispatch was not found on unfoundbox."
>
  <div class="container-narrow not-found-page">
    <div class="film-card not-found-card">
      <div class="not-found-code">404 · MISSING REEL</div>
      <h1 class="not-found-title">Scene Not Found</h1>
      <p class="not-found-desc">
        The dispatch, experiment, or visual report you are looking for has either moved to another reel or hasn't been cut yet.
      </p>
      <div class="not-found-actions">
        <a href="/" class="btn-vintage btn-vintage-ink">Return to Index →</a>
        <a href="/posts/" class="btn-vintage btn-vintage-paper">Browse Writing →</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    padding: 6rem 1.5rem 8rem;
  }

  .not-found-card {
    padding: clamp(32px, 6vw, 60px) 24px;
    text-align: center;
    background: #FAF8F5;
  }

  .not-found-code {
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 12px;
  }

  .not-found-title {
    font-family: var(--font-typewriter-display);
    font-size: clamp(32px, 6vw, 48px);
    margin-bottom: 14px;
  }

  .not-found-desc {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--text-body);
    max-width: 480px;
    margin: 0 auto 28px;
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
