---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found"
  description="The requested page could not be located on unfoundbox."
>
  <div class="not-found-page container-narrow">
    <div class="not-found-content lab-card">
      <span class="error-code">404</span>
      <h1 class="error-title">Page not found</h1>
      <p class="error-desc">
        The experiment, essay, or research note you're looking for doesn't exist or has moved across the edge.
      </p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Return Home</a>
        <a href="/posts/" class="btn btn-secondary">Browse Writing</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    padding: 6rem 0 8rem;
    text-align: center;
  }

  .not-found-content {
    padding: 4rem 2rem;
    align-items: center;
  }

  .error-code {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }

  .error-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .error-desc {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 480px;
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
