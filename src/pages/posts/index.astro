---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import FilmSectionHeader from '../../components/FilmSectionHeader.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const allTags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags || []))).sort();
---

<BaseLayout
  title="All Dispatches & Research Notes"
  description="Archive of all essays, technical research notes, and field observations by Saurabh Nandwana."
>
  <div class="posts-archive-page container">
    <header class="archive-header">
      <div class="header-prompt">
        <span>&gt; cat /var/log/dispatches.md</span>
      </div>
      <h1 class="archive-title">Writing &amp; Field Notes</h1>
      <p class="archive-sub">
        Essays, architecture breakdowns, and notes from the frontier of local AI, WebGPU, video infrastructure, and building products.
      </p>

      {allTags.length > 0 && (
        <div class="tag-filter-box">
          <span class="filter-label">Filter by topic:</span>
          <div class="filter-tags">
            {allTags.map((tag) => (
              <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="vintage-tag">
                {tag}
              </a>
            ))}
          </div>
        </div>
      )}
    </header>

    <div class="posts-grid-layout">
      {sortedPosts.map((post) => (
        <PostCard post={post} readingTime={getReadingTime(post.body || '')} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .posts-archive-page {
    padding: 3.5rem 1.5rem 6rem;
  }

  .archive-header {
    margin-bottom: 3rem;
    max-width: 800px;
  }

  .header-prompt {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .archive-title {
    font-family: var(--font-typewriter-display);
    font-size: clamp(32px, 6vw, 48px);
    margin-bottom: 12px;
  }

  .archive-sub {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-body);
    margin-bottom: 24px;
  }

  .tag-filter-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 2px solid #111111;
  }

  .filter-label {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .filter-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .posts-grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
</style>
