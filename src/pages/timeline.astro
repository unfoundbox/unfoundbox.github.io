---
import BaseLayout from '../layouts/BaseLayout.astro';
import FilmSectionHeader from '../components/FilmSectionHeader.astro';
import { timelineMilestones, nomadPlaces } from '../data/timeline';
---

<BaseLayout
  title="Career & Nomad Timeline"
  description="Chronological journey of Saurabh Nandwana — startups, acquisitions, layoffs, nomad life in SE Asia, and independent building."
>
  <div class="timeline-page container-narrow">
    <header class="timeline-page-header">
      <div class="header-prompt">
        <span>&gt; git log --reverse --oneline career.log</span>
      </div>
      <h1 class="timeline-title">Career &amp; Nomad Timeline</h1>
      <p class="timeline-sub">
        A chronological field log of 8+ years across early-stage startups, video compression, acqui-hires, sabbaticals, and nomading across South East Asia.
      </p>
    </header>

    <div class="timeline-list">
      {timelineMilestones.map((m, idx) => (
        <div class="timeline-item film-card">
          <div class="item-header-row">
            <span class="vintage-tag vintage-tag-ink">{m.period}</span>
            <span class="item-location">{m.location}</span>
          </div>

          <h3 class="item-role">{m.role}</h3>
          <h4 class="item-company">
            {m.companyUrl ? (
              <a href={m.companyUrl} target="_blank" rel="noreferrer">{m.company}</a>
            ) : (
              <span>{m.company}</span>
            )}
          </h4>

          <p class="item-desc">{m.description}</p>

          {m.stats && m.stats.length > 0 && (
            <div class="stat-grid-vintage">
              {m.stats.map((s) => (
                <div class="stat-cell">
                  <div class="stat-value">{s.value}</div>
                  <div class="stat-label">{s.label}</div>
                </div>
              ))}
            </div>
          )}

          <ul class="item-highlights">
            {m.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>

          <div class="item-tags">
            {m.tags.map((t) => (
              <span class="vintage-tag vintage-tag-dashed">{t}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .timeline-page {
    padding: 3.5rem 1.5rem 6rem;
  }

  .timeline-page-header {
    margin-bottom: 3rem;
  }

  .header-prompt {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .timeline-title {
    font-family: var(--font-typewriter-display);
    font-size: clamp(32px, 6vw, 46px);
    margin-bottom: 12px;
  }

  .timeline-sub {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .timeline-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .timeline-item {
    background: #FAF8F5;
    padding: clamp(20px, 3.5vw, 30px);
  }

  .item-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    margin-bottom: 10px;
  }

  .item-location {
    color: var(--text-muted);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .item-role {
    font-family: var(--font-typewriter-display);
    font-size: clamp(22px, 3.5vw, 26px);
    margin-bottom: 2px;
  }

  .item-company {
    font-size: 14px;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .item-company a {
    color: var(--text-ink);
    border-bottom: 1px solid #111111 !important;
  }

  .item-desc {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: 14px;
  }

  .item-highlights {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 14px 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .item-highlights li {
    margin-bottom: 4px;
  }

  .item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
</style>
