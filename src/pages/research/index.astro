---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { researchItems } from '../../data/research';
---

<BaseLayout
  title="Research Lab & Visual Reports"
  description="Interactive visual reports, WebGPU inference benchmarks, and AI landscape taxonomies by Saurabh Nandwana."
>
  <div class="research-archive-page container">
    <header class="research-header">
      <div class="header-prompt">
        <span>&gt; /research/run_benchmarks.sh</span>
      </div>
      <h1 class="research-title">Research Lab &amp; Visual Reports</h1>
      <p class="research-sub">
        Standalone interactive visual reports, WebGPU SLM benchmarks, India data center topology breakdowns, and small robotics brains.
      </p>
    </header>

    <div class="research-grid-layout">
      {researchItems.map((item) => (
        <ResearchCard item={item} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .research-archive-page {
    padding: 3.5rem 1.5rem 6rem;
  }

  .research-header {
    margin-bottom: 3rem;
    max-width: 820px;
  }

  .header-prompt {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .research-title {
    font-family: var(--font-typewriter-display);
    font-size: clamp(32px, 6vw, 48px);
    margin-bottom: 12px;
  }

  .research-sub {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .research-grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
</style>
