---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchCard from '../../components/ResearchCard.astro';
import { researchItems } from '../../data/research';
---

<BaseLayout
  title="Research Lab"
  description="Standalone interactive visual reports, AI landscape maps, WebGPU benchmarks, and infrastructure analyses by Saurabh Nandwana."
>
  <div class="research-page container">
    <header class="page-header">
      <span class="page-eyebrow">Interactive Lab</span>
      <h1 class="page-title">Research & Visual Reports</h1>
      <p class="page-subtitle">
        Visual maps, live WebGPU benchmarks, system diagrams, and deep reports. These interactive reports are designed for immersive exploration on desktop and mobile.
      </p>
    </header>

    <div class="research-grid">
      {researchItems.map((item) => (
        <ResearchCard item={item} />
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .research-page {
    padding: 3.5rem 0 6rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
    max-width: 800px;
  }

  .page-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .research-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .research-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
