---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import FilmSectionHeader from '../../components/FilmSectionHeader.astro';
import { projects } from '../../data/projects';
import { siteConfig } from '../../data/site';
---

<BaseLayout
  title="What I'm Building — Ventures & Labs"
  description="Startup ventures, video super-resolution engines, 3D web environments, and open-source tools built by Saurabh Nandwana."
>
  <div class="building-archive-page container">
    <header class="building-header">
      <div class="header-prompt">
        <span>&gt; whoami --building</span>
      </div>
      <h1 class="building-title">Ventures &amp; What I'm Building</h1>
      <p class="building-sub">
        A catalog of startup applications, video processing engines (Katana), programmatic motion suites (MotionVector), interactive 3D web spaces (Lookaround), and open-source experiments.
      </p>
    </header>

    <div class="projects-grid-layout">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <section class="github-tinkers-box film-card">
      <div class="tinkers-header">
        <span class="vintage-tag vintage-tag-ink">Open Source &amp; Research</span>
        <span>github.com/unfoundbox</span>
      </div>
      <h3 class="tinkers-title">Looking for shaders, WebCodecs scripts &amp; robotics builds?</h3>
      <p class="tinkers-desc">
        All experimental harnesses, WebGPU compute shaders, and research repositories are published openly on GitHub.
      </p>
      <a href={siteConfig.social.github} target="_blank" rel="noreferrer" class="btn-vintage btn-vintage-ink">
        Visit GitHub Profile →
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .building-archive-page {
    padding: 3.5rem 1.5rem 6rem;
  }

  .building-header {
    margin-bottom: 3rem;
    max-width: 820px;
  }

  .header-prompt {
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .building-title {
    font-family: var(--font-typewriter-display);
    font-size: clamp(32px, 6vw, 48px);
    margin-bottom: 12px;
  }

  .building-sub {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-body);
  }

  .projects-grid-layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }

  .github-tinkers-box {
    background: #FAF8F5;
    padding: clamp(24px, 4vw, 36px);
  }

  .tinkers-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 10px;
  }

  .tinkers-title {
    font-family: var(--font-typewriter-display);
    font-size: clamp(20px, 3.2vw, 26px);
    margin-bottom: 8px;
  }

  .tinkers-desc {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: 20px;
    max-width: 680px;
  }
</style>
