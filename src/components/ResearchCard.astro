---
import type { ResearchItem } from '../data/research';

interface Props {
  item: ResearchItem;
}

const { item } = Astro.props;
---

<div class="research-card film-card">
  <div class="research-header">
    <span class="vintage-tag vintage-tag-ink">{item.category}</span>
    <span class="research-date">{item.date}</span>
  </div>

  <h3 class="research-title">
    <a href={item.url}>{item.title}</a>
  </h3>

  <p class="research-desc">{item.description}</p>

  <div class="research-tags">
    {item.tags.map((tag) => (
      <span class="vintage-tag vintage-tag-dashed">{tag}</span>
    ))}
  </div>

  <div class="research-action">
    <a href={item.url} class="btn-vintage btn-vintage-ink">
      {item.isStandalone ? 'Open Visual Reel →' : 'Read Writeup →'}
    </a>
  </div>
</div>

<style>
  .research-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg-paper);
    border: 2px solid #111111;
    padding: 20px;
    box-shadow: 6px 6px 0 rgba(17, 17, 17, 0.18);
  }

  .research-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .research-date {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .research-title {
    font-family: var(--font-typewriter-display);
    font-size: 22px;
    line-height: 1.25;
    margin-bottom: 10px;
  }

  .research-title a {
    color: var(--text-ink);
    border-bottom: 2px solid transparent !important;
  }

  .research-title a:hover {
    border-bottom-color: var(--text-ink) !important;
  }

  .research-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: 14px;
    flex-grow: 1;
  }

  .research-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .research-action {
    padding-top: 12px;
    border-top: 1px dashed rgba(17, 17, 17, 0.3);
  }
</style>
