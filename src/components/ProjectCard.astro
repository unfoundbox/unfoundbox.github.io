---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class="project-card film-card">
  <div class="project-top">
    <div class="project-title-row">
      <h3 class="project-name">
        {project.name}
      </h3>
      {project.badge && (
        <span class="vintage-tag vintage-tag-ink">{project.badge}</span>
      )}
    </div>
    <p class="project-tagline">{project.tagline}</p>
  </div>

  <p class="project-desc">{project.description}</p>

  {project.metrics && project.metrics.length > 0 && (
    <div class="stat-grid-vintage">
      {project.metrics.map((m) => (
        <div class="stat-cell">
          <div class="stat-value">{m.value}</div>
          <div class="stat-label">{m.label}</div>
        </div>
      ))}
    </div>
  )}

  <div class="project-tags">
    {project.tags.map((tag) => (
      <span class="vintage-tag vintage-tag-dashed">{tag}</span>
    ))}
  </div>

  <div class="project-links">
    {project.url && (
      <a href={project.url} target={project.url.startsWith('http') ? '_blank' : undefined} rel={project.url.startsWith('http') ? 'noreferrer' : undefined} class="btn-vintage btn-vintage-ink">
        Launch / View →
      </a>
    )}
    {project.githubUrl && (
      <a href={project.githubUrl} target="_blank" rel="noreferrer" class="btn-vintage btn-vintage-paper">
        GitHub
      </a>
    )}
  </div>
</div>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg-paper);
    border: 2px solid #111111;
    padding: 20px;
    box-shadow: 6px 6px 0 rgba(17, 17, 17, 0.18);
  }

  .project-top {
    margin-bottom: 8px;
  }

  .project-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .project-name {
    font-family: var(--font-typewriter-display);
    font-size: 23px;
    color: var(--text-ink);
  }

  .project-tagline {
    font-size: 13.5px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .project-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: 12px;
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 12px 0 16px;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px dashed rgba(17, 17, 17, 0.3);
  }
</style>
