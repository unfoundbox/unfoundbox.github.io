---
import { siteConfig } from '../data/site';
---

<header class="hero-header">
  <div class="hero-left">
    <div class="hero-prompt">
      <span>&gt; whoami</span>
      <span class="prompt-cursor"></span>
    </div>

    <h1 class="hero-name">
      Saurabh<br />
      Nandwana
    </h1>

    <div class="hero-badges">
      <span class="vintage-tag vintage-tag-ink">0 → 1 Engineer</span>
      <span class="vintage-tag">Local AI · Video Infra</span>
      <span class="vintage-tag vintage-tag-dashed">Udaipur · SE Asia</span>
    </div>

    <p class="hero-intro">
      Early-stage startup engineer (ex-Hopin, ex-StreamYard, Vectorly). Building at the edge of WebGPU video super-resolution, local model inference, and web-native tools.
    </p>

    <div class="hero-cta-row">
      <a href="#track-record" class="btn-vintage btn-vintage-ink">Explore Reels ↓</a>
      <a href="/posts/sabbatical/" class="btn-vintage btn-vintage-paper">The Backstory →</a>
      <a href={siteConfig.social.twitter} target="_blank" rel="noreferrer" class="btn-vintage btn-vintage-paper">X / Twitter</a>
      <a href={siteConfig.social.github} target="_blank" rel="noreferrer" class="btn-vintage btn-vintage-paper">GitHub</a>
    </div>
  </div>

  <div class="hero-slate-card">
    <div class="slate-top-bar">
      <span>Scene 001</span>
      <span>Take 27</span>
      <span>B&amp;W</span>
    </div>
    <div class="filmstrip-strip"></div>
    <div class="slate-media">
      <img
        src="/avatar.jpg"
        alt="Saurabh Nandwana portrait"
        class="slate-img"
      />
      <span class="unedited-stamp">Unedited<br />footage</span>
    </div>
    <div class="filmstrip-strip"></div>
    <div class="slate-bottom-bar">
      Dir. himself · Runtime: ongoing
    </div>
  </div>
</header>

<style>
  .hero-header {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: clamp(28px, 5vw, 52px);
    align-items: end;
    padding: clamp(34px, 6vw, 60px) 0 clamp(28px, 4vw, 42px);
  }

  .hero-left {
    display: grid;
    gap: 18px;
  }

  .hero-prompt {
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
    display: flex;
    align-items: center;
  }

  .prompt-cursor {
    display: inline-block;
    width: 9px;
    height: 14px;
    background: #111111;
    margin-left: 5px;
    animation: blink 1.1s step-end infinite;
  }

  .hero-name {
    font-family: var(--font-typewriter-display);
    font-size: clamp(38px, 8.5vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-shadow: 4px 4px 0 rgba(17, 17, 17, 0.12);
  }

  .hero-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
  }

  .hero-intro {
    font-size: clamp(16px, 1.9vw, 18.5px);
    line-height: 1.7;
    color: var(--text-body);
    max-width: 48ch;
  }

  .hero-cta-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 6px;
  }

  .hero-slate-card {
    display: grid;
    gap: 0;
    position: relative;
    border: 3px solid #111111;
    box-shadow: 8px 8px 0 rgba(17, 17, 17, 0.2);
    width: 100%;
    max-width: 320px;
    justify-self: end;
    background: #111111;
  }

  .slate-top-bar {
    background: #111111;
    color: #F4F2ED;
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .slate-media {
    position: relative;
    background: #DDDAD3;
    overflow: hidden;
  }

  .slate-img {
    display: block;
    width: 100%;
    height: clamp(200px, 35vw, 290px);
    object-fit: cover;
    filter: contrast(1.05) grayscale(20%);
    border: none;
    box-shadow: none;
    margin: 0;
  }

  .slate-bottom-bar {
    background: #111111;
    color: #F4F2ED;
    padding: 8px 14px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
  }

  .unedited-stamp {
    position: absolute;
    bottom: 20px;
    left: -20px;
    z-index: 2;
    background: #F4F2ED;
    border: 2px solid #111111;
    border-radius: 50%;
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
    text-align: center;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.3;
    transform: rotate(-9deg);
    animation: wob 5s ease-in-out infinite;
    box-shadow: 3px 3px 0 rgba(17, 17, 17, 0.2);
  }

  @media (max-width: 768px) {
    .hero-slate-card {
      justify-self: start;
      margin-top: 1rem;
    }
  }
</style>
