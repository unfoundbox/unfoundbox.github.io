---
// Minimalist typewriter field dispatch form
---

<section class="newsletter-box film-card" id="subscribe">
  <div class="newsletter-header">
    <div class="newsletter-badge">
      <span class="badge-rec-dot"></span>
      <span>REEL DISPATCH · UNFOUNDBOX</span>
    </div>
    <h3 class="newsletter-title">Subscribe to the field logs</h3>
    <p class="newsletter-desc">
      Raw working notes from the edge of local AI, WebGPU shaders, video pipelines, and startup building. Delivered when there's something real to report.
    </p>
  </div>

  <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed! Welcome to the dispatch.');">
    <div class="form-row">
      <input 
        type="email" 
        placeholder="your.email@domain.com" 
        required 
        class="vintage-input" 
        aria-label="Email address"
      />
      <button type="submit" class="btn-vintage btn-vintage-ink">
        Join Dispatch →
      </button>
    </div>
    <div class="rss-line">
      <span>Prefer RSS reader?</span>
      <a href="/rss.xml" class="rss-link">Add /rss.xml to feed →</a>
    </div>
  </form>
</section>

<style>
  .newsletter-box {
    background: var(--bg-paper);
    border: 3px solid #111111;
    box-shadow: 8px 8px 0 rgba(17, 17, 17, 0.2);
    padding: clamp(24px, 4vw, 36px);
    margin: 3.5rem 0 2rem;
  }

  .newsletter-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .badge-rec-dot {
    width: 7px;
    height: 7px;
    background: #111111;
    display: inline-block;
    animation: blink 1.2s step-end infinite;
  }

  .newsletter-title {
    font-family: var(--font-typewriter-display);
    font-size: clamp(22px, 3.5vw, 32px);
    margin-bottom: 8px;
  }

  .newsletter-desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-body);
    max-width: 580px;
    margin-bottom: 20px;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 500px;
    margin-bottom: 12px;
  }

  .vintage-input {
    background: var(--bg-paper);
    border: 2px solid #111111;
    padding: 12px 14px;
    font-family: var(--font-typewriter);
    font-size: 14px;
    color: var(--text-ink);
  }

  .vintage-input:focus {
    outline: none;
    border-color: #111111;
    background: #ffffff;
  }

  .rss-line {
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
  }

  .rss-link {
    color: var(--text-ink);
    font-weight: 700;
    margin-left: 4px;
    border-bottom: 1px solid #111111 !important;
  }

  @media (min-width: 600px) {
    .form-row {
      flex-direction: row;
    }
    .vintage-input {
      flex-grow: 1;
    }
  }
</style>
