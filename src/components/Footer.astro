---
import { siteConfig } from '../data/site';
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/" class="brand-name">
          unfoundbox<span class="dot">.</span>
        </a>
        <p class="brand-bio">
          Independent notes on local AI, WebGPU, video infrastructure, and startup engineering.
        </p>
      </div>

      <div class="footer-links-grid">
        <div class="link-col">
          <h4 class="col-title">Navigation</h4>
          <ul class="col-list">
            <li><a href="/posts/">Writing</a></li>
            <li><a href="/research/">Research Lab</a></li>
            <li><a href="/building/">Building</a></li>
            <li><a href="/timeline/">Timeline</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </div>

        <div class="link-col">
          <h4 class="col-title">Connect</h4>
          <ul class="col-list">
            <li><a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub</a></li>
            <li><a href={siteConfig.social.twitter} target="_blank" rel="noreferrer">X (Twitter)</a></li>
            <li><a href={siteConfig.social.linkedin} target="_blank" rel="noreferrer">LinkedIn</a></li>
            <li><a href={siteConfig.social.instagram} target="_blank" rel="noreferrer">Instagram</a></li>
            <li><a href="/rss.xml">RSS Feed</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} {siteConfig.author}. Built with Astro & Markdown.
      </p>
      <div class="footer-status">
        <span class="status-indicator"></span>
        <span class="status-text">{siteConfig.location}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    padding: 4.5rem 0 2.5rem;
    font-size: 0.9rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-brand {
    max-width: 360px;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 750;
    color: var(--text-primary);
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .brand-name .dot {
    color: var(--accent);
  }

  .brand-bio {
    color: var(--text-secondary);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .footer-links-grid {
    display: flex;
    gap: 4rem;
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .col-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .col-list a {
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .col-list a:hover {
    color: var(--accent-light);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .footer-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .status-indicator {
    width: 7px;
    height: 7px;
    background: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.4);
  }

  @media (min-width: 768px) {
    .footer-top {
      flex-direction: row;
      justify-content: space-between;
    }
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
