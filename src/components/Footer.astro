---
import { siteConfig } from '../data/site';
---

<footer class="vintage-footer">
  <div class="filmstrip-strip"></div>
  
  <div class="container footer-content">
    <div class="footer-top-row">
      <div class="footer-brand-block">
        <h3 class="footer-title">{siteConfig.title}</h3>
        <p class="footer-tagline">
          Written & cut by {siteConfig.author} · Recorded in Rajasthan & South East Asia.
        </p>
      </div>

      <div class="footer-nav-groups">
        <div class="footer-nav-col">
          <span class="col-heading">Chapters</span>
          <a href="/#index">00 Index</a>
          <a href="/#track-record">01 Track Record</a>
          <a href="/#building">02 Ventures</a>
          <a href="/#research">03 Research Lab</a>
          <a href="/#nomad-journey">04 Nomad Story</a>
          <a href="/posts/sabbatical/">05 Backstory</a>
        </div>

        <div class="footer-nav-col">
          <span class="col-heading">Connect</span>
          <a href={siteConfig.social.twitter} target="_blank" rel="noreferrer">X (Twitter)</a>
          <a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub</a>
          <a href={siteConfig.social.instagram} target="_blank" rel="noreferrer">Instagram</a>
          <a href={siteConfig.social.nomads} target="_blank" rel="noreferrer">Nomads.com</a>
          <a href={siteConfig.social.substack} target="_blank" rel="noreferrer">Substack</a>
          <a href={siteConfig.social.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
          <a href={siteConfig.social.medium} target="_blank" rel="noreferrer">Medium</a>
          <a href="/rss.xml">RSS XML</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom-row">
      <span>© {new Date().getFullYear()} {siteConfig.author} · All rights reserved.</span>
      <span class="credits-badge">Runtime: Ongoing ✱ Built with Astro</span>
    </div>
  </div>

  <div class="filmstrip-strip"></div>
</footer>

<style>
  .vintage-footer {
    background: #111111;
    color: #F4F2ED;
    margin-top: auto;
    border-top: 3px solid #111111;
  }

  .footer-content {
    padding: 3.5rem 1.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2.5rem;
    flex-wrap: wrap;
  }

  .footer-brand-block {
    max-width: 380px;
  }

  .footer-title {
    font-family: var(--font-typewriter-display);
    font-size: 28px;
    color: #F4F2ED;
    margin-bottom: 8px;
  }

  .footer-tagline {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(244, 242, 237, 0.7);
  }

  .footer-nav-groups {
    display: flex;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .col-heading {
    font-family: var(--font-typewriter-display);
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #F4F2ED;
    margin-bottom: 4px;
  }

  .footer-nav-col a {
    color: rgba(244, 242, 237, 0.7);
    font-size: 13px;
    border-bottom: 1px dashed rgba(244, 242, 237, 0.25) !important;
  }

  .footer-nav-col a:hover {
    color: #F4F2ED;
    border-bottom-color: #F4F2ED !important;
  }

  .footer-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px dashed rgba(244, 242, 237, 0.2);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(244, 242, 237, 0.6);
  }

  .credits-badge {
    color: #F4F2ED;
  }
</style>
