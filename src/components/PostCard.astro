---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  readingTime?: string;
}

const { post, readingTime } = Astro.props;
const { title, description, date, tags, featured } = post.data;

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(date);
---

<article class={`post-card film-card ${featured ? 'featured-card' : ''}`}>
  <div class="card-meta-row">
    <span class="card-date">{formattedDate}</span>
    {readingTime && <span class="card-readtime">[{readingTime}]</span>}
  </div>

  <h3 class="card-title">
    <a href={`/posts/${post.slug}/`}>{title}</a>
  </h3>

  {description && <p class="card-desc">{description}</p>}

  {tags && tags.length > 0 && (
    <div class="card-tags">
      {tags.map((tag) => (
        <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="vintage-tag">
          {tag}
        </a>
      ))}
    </div>
  )}

  <div class="card-action">
    <a href={`/posts/${post.slug}/`} class="read-essay-link">
      Read Dispatch →
    </a>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--bg-paper);
    border: 2px solid #111111;
    padding: 20px;
    box-shadow: 6px 6px 0 rgba(17, 17, 17, 0.18);
  }

  .post-card.featured-card {
    border: 3px solid #111111;
    box-shadow: 8px 8px 0 rgba(17, 17, 17, 0.22);
  }

  .card-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .card-title {
    font-family: var(--font-typewriter-display);
    font-size: 21px;
    line-height: 1.25;
    margin-bottom: 10px;
  }

  .card-title a {
    color: var(--text-ink);
    border-bottom: 2px solid transparent !important;
  }

  .card-title a:hover {
    border-bottom-color: var(--text-ink) !important;
  }

  .card-desc {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: 16px;
    flex-grow: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .card-action {
    padding-top: 12px;
    border-top: 1px dashed rgba(17, 17, 17, 0.3);
  }

  .read-essay-link {
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-ink);
    border-bottom: 2px solid var(--text-ink) !important;
  }
</style>
