---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  readingTime?: string;
}

const { post, readingTime } = Astro.props;
const { title, description, date, tags, featured } = post.data;

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(date);
---

<article class={`post-card lab-card ${featured ? 'is-featured' : ''}`}>
  <div class="card-header">
    <div class="card-meta">
      <time datetime={date.toISOString()} class="post-date">
        {formattedDate}
      </time>
      {readingTime && (
        <span class="reading-time">
          <span class="meta-dot">·</span>
          {readingTime}
        </span>
      )}
    </div>

    {featured && <span class="featured-badge">Featured</span>}
  </div>

  <h3 class="post-title">
    <a href={`/posts/${post.slug}/`}>{title}</a>
  </h3>

  {description && <p class="post-desc">{description}</p>}

  {tags && tags.length > 0 && (
    <div class="tags-container">
      {tags.map((tag) => (
        <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="tag-badge tag-badge-secondary">
          {tag}
        </a>
      ))}
    </div>
  )}

  <div class="card-footer">
    <a href={`/posts/${post.slug}/`} class="read-link">
      <span>Read essay</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</article>

<style>
  .post-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .post-card.is-featured {
    border-color: rgba(229, 155, 60, 0.25);
    background: linear-gradient(180deg, rgba(229, 155, 60, 0.03) 0%, var(--bg-card) 100%);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .meta-dot {
    color: var(--border-medium);
  }

  .featured-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--border-accent);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
  }

  .post-title {
    font-size: 1.28rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .post-title a {
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .post-title a:hover {
    color: var(--accent-light);
  }

  .post-desc {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .tags-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .card-footer {
    display: flex;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .read-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    transition: all var(--transition-fast);
  }

  .read-link svg {
    transition: transform var(--transition-fast);
  }

  .post-card:hover .read-link {
    color: var(--accent-light);
  }

  .post-card:hover .read-link svg {
    transform: translateX(3px);
  }
</style>
