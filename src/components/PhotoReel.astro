---
export interface PhotoItem {
  src: string;
  alt: string;
  caption?: string;
  location?: string;
  tag?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  photos: PhotoItem[];
}

const {
  title = "Field Contact Sheet",
  subtitle = "Unedited rolls · Rajasthan, SE Asia & Nomad Stays",
  photos = []
} = Astro.props;
---

<div class="photo-reel-block">
  <div class="filmstrip-strip"></div>
  
  <div class="reel-gallery-grid">
    {photos.map((photo, index) => (
      <div class="film-frame-card">
        <div class="frame-top-tag">
          <span>FRAME 0{index + 1}</span>
          {photo.tag && <span class="frame-tag-badge">{photo.tag}</span>}
        </div>
        <div class="frame-image-wrapper">
          <img
            src={photo.src}
            alt={photo.alt}
            class="frame-img"
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='grid';"
          />
          <div class="frame-fallback" style="display: none;">
            <span>{photo.caption || photo.alt}</span>
          </div>
        </div>
        {(photo.caption || photo.location) && (
          <div class="frame-caption-row">
            {photo.caption && <span class="frame-caption-text">{photo.caption}</span>}
            {photo.location && <span class="frame-location-text">[{photo.location}]</span>}
          </div>
        )}
      </div>
    ))}
  </div>

  <div class="filmstrip-strip"></div>
</div>

<style>
  .photo-reel-block {
    margin: 2.5rem 0;
    border: 3px solid #111111;
    background: #111111;
    box-shadow: 8px 8px 0 rgba(17, 17, 17, 0.2);
  }

  .reel-gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 3px;
    background: #111111;
    padding: 3px;
  }

  .film-frame-card {
    background: var(--bg-paper);
    border: 1px solid #111111;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .frame-top-tag {
    background: #111111;
    color: #F4F2ED;
    padding: 6px 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 9.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .frame-tag-badge {
    color: var(--accent-amber-light);
  }

  .frame-image-wrapper {
    position: relative;
    width: 100%;
    height: clamp(140px, 22vw, 200px);
    background: #E5E2DA;
    overflow: hidden;
  }

  .frame-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    margin: 0 !important;
    border: none !important;
    box-shadow: none !important;
    filter: contrast(1.04) grayscale(10%);
    transition: transform 0.25s ease;
  }

  .film-frame-card:hover .frame-img {
    transform: scale(1.03);
  }

  .frame-fallback {
    width: 100%;
    height: 100%;
    place-items: center;
    text-align: center;
    padding: 1rem;
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #E5E2DA;
  }

  .frame-caption-row {
    padding: 8px 10px;
    background: var(--bg-paper);
    font-size: 11px;
    line-height: 1.4;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 6px;
    border-top: 1px dashed rgba(17, 17, 17, 0.25);
  }

  .frame-caption-text {
    font-weight: 700;
    color: var(--text-ink);
  }

  .frame-location-text {
    color: var(--text-muted);
    font-size: 10px;
    letter-spacing: 0.05em;
  }
</style>
