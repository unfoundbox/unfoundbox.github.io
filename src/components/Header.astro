---
import { siteConfig } from '../data/site';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<div class="warning-tape">
  <span class="warning-tape-badge">
    FIELD DISPATCHES ✱ LOCAL AI · WEBGPU VIDEO INFRA · NOMAD LOGS ✱ BUILDING IN THE OPEN
  </span>
</div>

<header class="sticky-nav">
  <div class="nav-inner">
    <a href="/" class="rec-brand">
      <span class="rec-dot"></span>
      <span class="rec-text">REC · {siteConfig.author}</span>
    </a>

    <nav class="nav-links-desktop">
      <a href="/#index" class="nav-item">Index</a>
      <a href="/#track-record" class="nav-item">Track Record</a>
      <a href="/#building" class="nav-item">Ventures</a>
      <a href="/#research" class="nav-item">Research</a>
      <a href="/#nomad-journey" class="nav-item">Nomad Story</a>
      <a href="/posts/sabbatical/" class="nav-item">Backstory</a>
      <a href="/#subscribe" class="nav-item">Dispatch</a>
      <a href={siteConfig.social.twitter} target="_blank" rel="noreferrer" class="nav-item nav-ext">X</a>
      <a href={siteConfig.social.github} target="_blank" rel="noreferrer" class="nav-item nav-ext">GitHub</a>
      <a href={siteConfig.social.linkedin} target="_blank" rel="noreferrer" class="nav-item nav-ext">LinkedIn</a>
    </nav>

    <button id="nav-toggle-btn" class="nav-toggle-mobile" aria-label="Toggle Menu">
      <span>MENU</span>
    </button>
  </div>

  <div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
    <div class="mobile-drawer-inner">
      <a href="/#index" class="mob-item">Index</a>
      <a href="/#track-record" class="mob-item">01 Track Record (Signzy, Vectorly, Hopin, StreamYard)</a>
      <a href="/#building" class="mob-item">02 Ventures (Katana, MotionVector, Launchy, Lookaround)</a>
      <a href="/#research" class="mob-item">03 Research Lab (WebGPU, AI Map, Data Centers, Gemma)</a>
      <a href="/#nomad-journey" class="mob-item">04 Nomad Story (Rajasthan → Cancun → SE Asia)</a>
      <a href="/posts/sabbatical/" class="mob-item">05 Full Backstory (Small Town Kid to Cutting-Edge AI)</a>
      <a href="/#subscribe" class="mob-item">06 Dispatch / Newsletter</a>
      <div class="mob-socials">
        <a href={siteConfig.social.twitter} target="_blank" rel="noreferrer">X (Twitter)</a>
        <a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub</a>
        <a href={siteConfig.social.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      </div>
    </div>
  </div>
</header>

<style>
  .sticky-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #111111;
    color: #F4F2ED;
    border-bottom: 2px solid #111111;
  }

  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px clamp(14px, 3vw, 22px);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .rec-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #F4F2ED;
    border-bottom: none !important;
    font-weight: 700;
  }

  .rec-dot {
    width: 9px;
    height: 9px;
    background: #F4F2ED;
    display: inline-block;
    animation: blink 1.4s step-end infinite;
  }

  .nav-links-desktop {
    display: none;
    gap: clamp(10px, 1.8vw, 18px);
    flex-wrap: wrap;
  }

  .nav-item {
    color: #F4F2ED;
    border-bottom: 1px solid rgba(244, 242, 237, 0.4) !important;
    transition: all 0.15s ease;
  }

  .nav-item:hover {
    color: #F4F2ED;
    border-bottom-color: #F4F2ED !important;
  }

  .nav-ext {
    color: rgba(244, 242, 237, 0.7);
  }

  .nav-toggle-mobile {
    display: block;
    background: transparent;
    border: 1px solid #F4F2ED;
    color: #F4F2ED;
    padding: 4px 8px;
    font-family: var(--font-typewriter);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    cursor: pointer;
  }

  .mobile-drawer {
    display: none;
    background: #111111;
    border-top: 1px dashed rgba(244, 242, 237, 0.3);
    padding: 18px clamp(14px, 3vw, 22px) 24px;
  }

  .mobile-drawer.is-open {
    display: block;
  }

  .mobile-drawer-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .mob-item {
    color: #F4F2ED;
    font-size: 12px;
    border-bottom: 1px dashed rgba(244, 242, 237, 0.25) !important;
    padding-bottom: 6px;
    line-height: 1.5;
  }

  .mob-socials {
    display: flex;
    gap: 14px;
    margin-top: 8px;
    font-size: 11.5px;
  }

  .mob-socials a {
    color: #F4F2ED;
  }

  @media (min-width: 900px) {
    .nav-links-desktop {
      display: flex;
    }
    .nav-toggle-mobile {
      display: none;
    }
    .mobile-drawer {
      display: none !important;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('nav-toggle-btn');
  const drawer = document.getElementById('mobile-drawer');
  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      drawer.classList.toggle('is-open');
    });
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        drawer.classList.remove('is-open');
      });
    });
  }
</script>
