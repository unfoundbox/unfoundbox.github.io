---
interface Props {
  num: string;
  title: string;
  meta: string;
}

const { num, title, meta } = Astro.props;
---

<div class="film-slate-header">
  <div class="slate-title-group">
    <span class="film-slate-num">{num}</span>
    <span class="film-slate-title">{title}</span>
  </div>
  <span class="film-slate-meta">{meta}</span>
</div>

<style>
  .film-slate-header {
    background: var(--bg-ink);
    color: var(--text-paper);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 14px 16px;
    box-shadow: 6px 6px 0 rgba(17, 17, 17, 0.2);
    margin-bottom: 1.5rem;
  }

  .slate-title-group {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .film-slate-num {
    font-family: var(--font-typewriter-display);
    font-size: 26px;
    line-height: 1;
  }

  .film-slate-title {
    font-size: 12.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .film-slate-meta {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(244, 242, 237, 0.65);
  }
</style>
