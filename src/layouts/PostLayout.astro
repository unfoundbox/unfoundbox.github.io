---
import BaseLayout from './BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { siteConfig } from '../data/site';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description?: string;
  date: Date;
  tags?: string[];
  coverImage?: string;
  headings?: Heading[];
  readingTime?: string;
}

const {
  title,
  description,
  date,
  tags = [],
  coverImage,
  headings = [],
  readingTime,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(date);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishDate={date}
  tags={tags}
  image={coverImage || '/avatar.jpg'}
>
  <article class="post-article container-narrow">
    <header class="article-header">
      <div class="article-nav">
        <a href="/posts/" class="back-link">
          ← All Dispatches
        </a>
        {tags.length > 0 && (
          <div class="article-tags">
            {tags.map((tag) => (
              <a href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}/`} class="vintage-tag">
                {tag}
              </a>
            ))}
          </div>
        )}
      </div>

      <div class="slate-title-box">
        <div class="slate-title-top">
          <span>Dispatch Log</span>
          <span>{formattedDate} {readingTime && `· ${readingTime}`}</span>
        </div>
        <h1 class="article-headline">{title}</h1>
        {description && <p class="article-lead">{description}</p>}
      </div>
    </header>

    {coverImage && (
      <div class="article-cover-frame">
        <img src={coverImage} alt={title} class="article-cover-img" />
      </div>
    )}

    <div class="prose">
      <slot />
    </div>

    <div class="author-credits film-card">
      <div class="credits-top">
        <span class="vintage-tag vintage-tag-ink">Author &amp; Engineer</span>
        <span>{siteConfig.location}</span>
      </div>
      <h4 class="credits-name">{siteConfig.author}</h4>
      <p class="credits-bio">
        Early-stage startup engineer (ex-Hopin, ex-StreamYard, Vectorly). Researching local WebGPU inference, building tools like Katana and Lookaround.
      </p>
      <div class="credits-socials">
        <a href={siteConfig.social.twitter} target="_blank" rel="noreferrer">Follow on X</a>
        <a href={siteConfig.social.github} target="_blank" rel="noreferrer">GitHub</a>
        <a href={siteConfig.social.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a href={siteConfig.social.medium} target="_blank" rel="noreferrer">Medium</a>
      </div>
    </div>

    <Newsletter />
  </article>
</BaseLayout>

<style>
  .post-article {
    padding: 3rem 1.5rem 5rem;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .article-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .back-link {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-ink);
    border-bottom: 2px solid var(--text-ink) !important;
  }

  .article-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .slate-title-box {
    border: 3px solid #111111;
    background: #FAF8F5;
    padding: clamp(20px, 3.5vw, 32px);
    box-shadow: 6px 6px 0 rgba(17, 17, 17, 0.2);
  }

  .slate-title-top {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 10px;
    border-bottom: 1px dashed rgba(17, 17, 17, 0.3);
    padding-bottom: 6px;
  }

  .article-headline {
    font-family: var(--font-typewriter-display);
    font-size: clamp(26px, 4.5vw, 42px);
    line-height: 1.15;
    margin-bottom: 12px;
  }

  .article-lead {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .article-cover-frame {
    margin: 2rem 0;
  }

  .article-cover-img {
    width: 100%;
    max-height: 440px;
    object-fit: cover;
    border: 3px solid #111111;
    box-shadow: 6px 6px 0 rgba(17, 17, 17, 0.2);
  }

  .author-credits {
    margin-top: 4rem;
    padding: 24px;
    background: #FAF8F5;
  }

  .credits-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .credits-name {
    font-family: var(--font-typewriter-display);
    font-size: 24px;
    margin-bottom: 6px;
  }

  .credits-bio {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-body);
    margin-bottom: 14px;
  }

  .credits-socials {
    display: flex;
    gap: 16px;
    font-size: 13px;
    font-weight: 700;
  }
</style>
